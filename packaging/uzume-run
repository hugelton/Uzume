# uzume launcher: SuperCollider (sclang + scsynth), then matron + crone + softcut (the `norns` binary).
# Part of uzume, GPL-3.0-or-later.
U=${UZUME_ROOT:-/opt/uzume}   # UZUME_ROOT: run an unpacked copy of the package (testing)
D=${XDG_DATA_HOME:-$HOME/.local/share}/uzume
W=$D/we                       # norns' $HOME: norns/ (read-only, from the package), dust/ (yours), matronrc.lua
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
export LD_LIBRARY_PATH=$U/lib PATH=$U/bin:$PATH
# libmonome (grids, arcs) loads its protocol modules from here, not from the /usr/local/lib it was built for
export MONOME_PROTOCOL_DIR=${MONOME_PROTOCOL_DIR:-$U/lib/monome}
mkdir -p "$W/dust/code" "$W/dust/audio" "$W/dust/data" "$D/cfg/SuperCollider" "$D/run"
ln -sfn $U/share/norns "$W/norns"
cp -n $U/etc/matronrc.lua "$W/matronrc.lua"
cp -rn $U/share/dust-default/. "$W/dust/code/"
sed "s#/opt/uzume#$U#g" $U/etc/startup.scd > "$D/cfg/SuperCollider/startup.scd"
cat > "$D/run/sclang.yaml" <<Y
includePaths:
    - $U/share/SuperCollider/SCClassLibrary
    - $U/share/sc/core
    - $U/share/sc/engines
    - $W/dust/code
excludePaths:
    - $U/share/SuperCollider/SCClassLibrary/Platform/iphone
postInlineWarnings: false
Y
# maiden, norns' web editor (off unless turned on): $D/maiden.conf, or UZUME_MAIDEN=1 / UZUME_MAIDEN_LISTEN=<address> for one run.
# It serves http://<address>:5000; the editor's two consoles talk to norns (5555) and SuperCollider (5556) through ws-wrapper.
# Anyone who can reach those ports can run any code as this user: there is no password. 127.0.0.1 keeps them on this device
# (from a computer: ssh -L 5000:127.0.0.1:5000 -L 5555:127.0.0.1:5555 -L 5556:127.0.0.1:5556 <user>@<device>, then open
# http://127.0.0.1:5000/maiden/ -- 127.0.0.1, not "localhost": the consoles only answer requests for the address they listen on).
[ -f "$D/maiden.conf" ] || cat > "$D/maiden.conf" <<'C'
# maiden (web editor) for uzume
# on=1 starts it with uzume (about 25 MB more memory). Then open http://<address>:5000/maiden/
on=0
# 127.0.0.1: this device only (from a computer: ssh port forwarding, then http://127.0.0.1:5000/maiden/).
# 0.0.0.0: every computer on the network can open it, and run any code on this device. There is no password.
listen=127.0.0.1
C
MAIDEN=${UZUME_MAIDEN:-$(sed -n 's/^on=\([01]\)[[:space:]]*$/\1/p' "$D/maiden.conf" | tail -1)}
MLISTEN=${UZUME_MAIDEN_LISTEN:-$(sed -n 's/^listen=\([0-9.]*\)[[:space:]]*$/\1/p' "$D/maiden.conf" | tail -1)}
: "${MLISTEN:=127.0.0.1}"
# ws-wrapper's listener also checks the address in each request: "*" is the form that accepts any, for listening everywhere
case $MLISTEN in 0.0.0.0) WSHOST='*';; *) WSHOST=$MLISTEN;; esac
[ "$MAIDEN" = 1 ] && [ -x "$U/bin/maiden" ] && [ -x "$U/bin/ws-wrapper" ] || MAIDEN=0
# Memory: the desktop's panel, file manager and portal / volume helpers are not needed while uzume runs (it uses PipeWire's
# own JACK interface and draws on the LCD, not on the desktop), and the Zero has 352 MB. They are stopped for the time uzume runs and started
# again when it ends. UZUME_KIOSK=0 leaves everything alone. Only the user's own services and processes are touched; nothing needs root.
KIOSK_USER_UNITS="xdg-desktop-portal-gtk.service xdg-desktop-portal-wlr.service xdg-desktop-portal.service xdg-document-portal.service xdg-permission-store.service gvfs-daemon.service gvfs-afc-volume-monitor.service gvfs-goa-volume-monitor.service gvfs-gphoto2-volume-monitor.service gvfs-mtp-volume-monitor.service gvfs-udisks2-volume-monitor.service mpris-proxy.service"
KIOSK=0; KIOSK_RESTORE=""
kiosk_on() {
  [ "${UZUME_KIOSK:-1}" = 1 ] || return 0
  [ -n "$(pgrep -u "$(id -u)" -x wf-panel-pi)" ] && KIOSK_PANEL=1
  [ -n "$(pgrep -u "$(id -u)" -x pcmanfm)" ] && KIOSK_FM=1
  pkill -u "$(id -u)" -f '^/bin/sh /usr/bin/lwrespawn /usr/bin/(pcmanfm-pi|wf-panel-pi)'
  pkill -u "$(id -u)" -x wf-panel-pi; pkill -u "$(id -u)" -x pcmanfm
  for u in $KIOSK_USER_UNITS; do
    if systemctl --user is-active --quiet "$u" 2>/dev/null; then KIOSK_RESTORE="$KIOSK_RESTORE $u"; systemctl --user stop "$u" >/dev/null 2>&1; fi
  done
  KIOSK=1
}
kiosk_off() {
  [ "$KIOSK" = 1 ] || return 0
  KIOSK=0
  # In a session of its own: it finishes even if this script is killed right after it ends, and the launcher, which waits until
  # every process of the group it started has ended before it draws its screen again, does not wait for these few seconds.
  setsid sh -c '
    [ "$1" = 1 ] && setsid /usr/bin/lwrespawn /usr/bin/pcmanfm-pi >/dev/null 2>&1 </dev/null &
    [ "$2" = 1 ] && setsid /usr/bin/lwrespawn /usr/bin/wf-panel-pi >/dev/null 2>&1 </dev/null &
    shift 2
    for u in "$@"; do case $u in *.socket) systemctl --user start "$u" >/dev/null 2>&1;; esac; done
    for u in "$@"; do case $u in *.service) systemctl --user start "$u" >/dev/null 2>&1;; esac; done
  ' kiosk-restore "${KIOSK_FM:-0}" "${KIOSK_PANEL:-0}" $KIOSK_RESTORE </dev/null >/dev/null 2>&1 &
}
cleanup() {
  [ "$SNAP" = 1 ] && [ -s "$D/run/fb.snapshot" ] && cat "$D/run/fb.snapshot" > $FB 2>/dev/null
  [ -n "$LAUNCHER" ] && kill -CONT "$LAUNCHER" 2>/dev/null
  pkill -u "$(id -u)" -x sclang; pkill -u "$(id -u)" -x scsynth; pkill -u "$(id -u)" -f '^tail -f /dev/null$'
  pkill -u "$(id -u)" -x maiden; pkill -u "$(id -u)" -x ws-wrapper
  [ -n "$GOPID" ] && { pkill -P "$GOPID" 2>/dev/null; kill "$GOPID" 2>/dev/null; }
  # norns' helper process (runs `os.execute` / `util.os_capture` commands) does not end when norns does
  pkill -u "$(id -u)" -f '^sidecar \[norns\]$'
  pw-metadata -n settings 0 clock.force-quantum 0 >/dev/null 2>&1
  kiosk_off
}
trap cleanup EXIT INT TERM
cleanup 2>/dev/null   # leftovers of an earlier run; this must come before the launcher is paused (cleanup continues it)
# The launcher only repaints what changed (its status bar), so it would show our last frame until a key is pressed:
# keep what it had on the LCD and put it back on exit.
FB=/dev/fb0
head -c 108800 $FB > "$D/run/fb.snapshot" 2>/dev/null && SNAP=1
# The launcher keeps drawing its status bar (clock, battery) over the LCD: it is paused while uzume runs. A watchdog continues it even if this
# script is killed, so it cannot stay frozen.
LAUNCHER=$(pgrep -x M5CardputerZero | head -1)
if [ -n "$LAUNCHER" ]; then
  kill -STOP "$LAUNCHER" 2>/dev/null
  setsid sh -c "while kill -0 $$ 2>/dev/null; do sleep 1; done; kill -CONT $LAUNCHER 2>/dev/null" >/dev/null 2>&1 </dev/null &
fi
kiosk_on
# No realtime priority for user processes on the Zero: at PipeWire's default 1024-frame quantum the graph missed
# deadlines (audible jitter). 2048 frames (43 ms) does not.
pw-metadata -n settings 0 clock.force-quantum 2048 >/dev/null 2>&1
# sclang first: its start-up peaks at about 95 MB, before matron and crone grow.
# Idle memory is pushed into zram while it is not used (libuzume-pageout.so, about 70 MB of RAM for the three programs); UZUME_PAGEOUT=0 turns it off.
PREL=${UZUME_PAGEOUT_LIB:-$U/lib/libuzume-pageout.so}
if [ "${UZUME_PAGEOUT:-1}" = 1 ] && [ -f "$PREL" ]; then PRE=$PREL; else PRE=; fi
GO=$D/run/pageout.go; rm -f "$GO"; export UZUME_PAGEOUT_GO=$GO       # the library waits for this file: sweeping during start-up would slow sclang to a crawl
if [ "$MAIDEN" = 1 ]; then  # the consoles: sclang reads what ws-wrapper passes from the browser (no -D)
  (ulimit -v 450000; LD_PRELOAD=$PRE XDG_CONFIG_HOME=$D/cfg ws-wrapper "ws://$WSHOST:5556" sclang -i maiden -l "$D/run/sclang.yaml" > "$D/run/sclang.log" 2>&1 </dev/null) &
else
  (ulimit -v 450000; LD_PRELOAD=$PRE XDG_CONFIG_HOME=$D/cfg sclang -D -l "$D/run/sclang.yaml" > "$D/run/sclang.log" 2>&1 </dev/null) &
fi
i=0; while [ $i -lt 60 ] && ! grep -q "initPolls" "$D/run/sclang.log" 2>/dev/null; do sleep 1; i=$((i+1)); done
cd "$W"; export HOME=$W
# by then norns has started and loaded the engines. In a session of its own, like kiosk_off(), so that the launcher does not wait for it.
setsid sh -c 'sleep 25; touch "$1"' pageout-go "$GO" </dev/null >/dev/null 2>&1 &
GOPID=$!
if [ "$MAIDEN" = 1 ]; then
  maiden server --host "$MLISTEN" --port 5000 --app "$U/share/maiden/app/" --data "$W/dust/" --doc "$W/norns/doc/" \
    --config "$U/share/maiden/maiden.yaml" > "$D/run/maiden.log" 2>&1 </dev/null &
  LD_PRELOAD=$PRE ws-wrapper "ws://$WSHOST:5555" $U/bin/norns > "$D/run/norns.log" 2>&1 </dev/null
else
  tail -f /dev/null | LD_PRELOAD=$PRE $U/bin/norns > "$D/run/norns.log" 2>&1
fi

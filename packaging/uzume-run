# Uzume launcher: SuperCollider (sclang + scsynth), then matron + crone + softcut (the `norns` binary).
# Part of Uzume, GPL-3.0-or-later.
U=${UZUME_ROOT:-/opt/uzume}   # UZUME_ROOT: run an unpacked copy of the package (testing)
D=${XDG_DATA_HOME:-$HOME/.local/share}/uzume
W=$D/we                       # norns' $HOME: norns/ (read-only, from the package), dust/ (yours), matronrc.lua
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; export XDG_RUNTIME_DIR
export LD_LIBRARY_PATH=$U/lib PATH=$U/bin:$PATH
mkdir -p "$W/dust/code" "$W/dust/audio" "$W/dust/data" "$D/cfg/SuperCollider" "$D/run"
ln -sfn $U/share/norns "$W/norns"
cp -n $U/etc/matronrc.lua "$W/matronrc.lua"
cp -rn $U/share/dust-default/. "$W/dust/code/"
sed "s#/opt/uzume#$U#g" $U/etc/startup.scd > "$D/cfg/SuperCollider/startup.scd"
cat > "$D/run/sclang.yaml" <<Y
includePaths:
    - $U/share/SuperCollider/SCClassLibrary
    - $U/share/sc/core
    - $U/share/sc/engines
    - $W/dust/code
excludePaths:
    - $U/share/SuperCollider/SCClassLibrary/Platform/iphone
postInlineWarnings: false
Y
# The launcher only repaints what changed (its status bar), so it would show our last frame until a key is pressed:
# keep what it had on the LCD and put it back on exit.
FB=/dev/fb0
head -c 108800 $FB > "$D/run/fb.snapshot" 2>/dev/null
cleanup() {
  [ -s "$D/run/fb.snapshot" ] && cat "$D/run/fb.snapshot" > $FB 2>/dev/null
  pkill -u "$(id -u)" -x sclang; pkill -u "$(id -u)" -x scsynth; pkill -u "$(id -u)" -f '^tail -f /dev/null$'
  pw-metadata -n settings 0 clock.force-quantum 0 >/dev/null 2>&1
}
trap cleanup EXIT INT TERM
cleanup 2>/dev/null
# No realtime priority for user processes on the Zero: at PipeWire's default 1024-frame quantum the graph missed
# deadlines (audible jitter). 2048 frames (43 ms) does not.
pw-metadata -n settings 0 clock.force-quantum 2048 >/dev/null 2>&1
# sclang first: its start-up peaks at about 95 MB, before matron and crone grow.
(ulimit -v 450000; XDG_CONFIG_HOME=$D/cfg sclang -D -l "$D/run/sclang.yaml" > "$D/run/sclang.log" 2>&1 </dev/null) &
i=0; while [ $i -lt 60 ] && ! grep -q "initPolls" "$D/run/sclang.log" 2>/dev/null; do sleep 1; i=$((i+1)); done
cd "$W"; export HOME=$W
tail -f /dev/null | $U/bin/norns > "$D/run/norns.log" 2>&1
